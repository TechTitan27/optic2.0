{
  "version": 2,
  "rewrites": [
    {
      "source": "/status",
      "destination": "/api/status"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/status",
      "destination": "/api/status"
    },
    {
      "source": "/v1/waitlist",
      "destination": "/api/waitlist"
    },
    {
      "source": "/api/deployments/:path*",
      "destination": "/api/deployments?path=:path*"
    },
    {
      "source": "/api/cloud/:path*",
      "destination": "/api/cloud"
    },
    {
      "source": "/api/hosting/:path*",
      "destination": "/api/hosting"
    },
    {
      "source": "/api/storage/:path*",
      "destination": "/api/storage"
    },
    {
      "source": "/api/keys/:path*",
      "destination": "/api/keys"
    },
    {
      "source": "/api/share/:path*",
      "destination": "/api/share"
    },
    {
      "source": "/api/organizations/:path*",
      "destination": "/api/organizations"
    },
    {
      "source": "/api/domains/:path*",
      "destination": "/api/domains"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
