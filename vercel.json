{
  "version": 2,
  "rewrites": [
    {
      "source": "/status",
      "destination": "/api/status"
    },
    {
      "source": "/api/status",
      "destination": "/api/status"
    },
    {
      "source": "/api/deployments/:action*",
      "destination": "/api/deployments"
    },
    {
      "source": "/api/hosting/:action*",
      "destination": "/api/hosting/:action*"
    },
    {
      "source": "/api/keys/:action*",
      "destination": "/api/keys/:action*"
    },
    {
      "source": "/api/storage/:action*",
      "destination": "/api/storage/:action*"
    },
    {
      "source": "/v1/keys/:action*",
      "destination": "/api/keys/:action*"
    },
    {
      "source": "/api/waitlist",
      "destination": "/api/waitlist"
    },
    {
      "source": "/v1/waitlist",
      "destination": "/api/waitlist"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
