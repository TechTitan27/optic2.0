{
  "version": 2,
  "rewrites": [
    {
      "source": "/status",
      "destination": "/api/status"
    },
    {
      "source": "/api/status",
      "destination": "/api/status"
    },
    {
      "source": "/api/health",
      "destination": "/api/status"
    },
    {
      "source": "/api/deployments/:action*",
      "destination": "/api/deployments"
    },
    {
      "source": "/api/storage/share",
      "destination": "/api/share"
    },
    {
      "source": "/api/storage/:action*",
      "destination": "/api/storage?action=:action*"
    },
    {
      "source": "/api/storage",
      "destination": "/api/storage"
    },
    {
      "source": "/api/share",
      "destination": "/api/share"
    },
    {
      "source": "/api/hosting/:action*",
      "destination": "/api/hosting?action=:action*"
    },
    {
      "source": "/api/hosting",
      "destination": "/api/hosting"
    },
    {
      "source": "/api/keys/:action*",
      "destination": "/api/keys?action=:action*"
    },
    {
      "source": "/api/keys",
      "destination": "/api/keys"
    },
    {
      "source": "/api/api-keys/:action*",
      "destination": "/api/keys?action=:action*"
    },
    {
      "source": "/api/api-keys",
      "destination": "/api/keys"
    },
    {
      "source": "/v1/keys/:action*",
      "destination": "/api/keys?action=:action*"
    },
    {
      "source": "/api/organizations/:action*",
      "destination": "/api/organizations?action=:action*"
    },
    {
      "source": "/api/organizations",
      "destination": "/api/organizations"
    },
    {
      "source": "/api/waitlist",
      "destination": "/api/waitlist"
    },
    {
      "source": "/v1/waitlist",
      "destination": "/api/waitlist"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
