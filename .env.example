# ============================================================
# OPTIC ENVIRONMENT CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# PUBLIC / CLIENT-SIDE VARIABLES (Browser-safe)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://dsrvkqutqxuvmfhbcuvy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Vite aliases for local build/dev compatibility
VITE_SUPABASE_URL=https://dsrvkqutqxuvmfhbcuvy.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------
# SERVER-ONLY VARIABLES (Never expose to browser)
# Provide in Vercel Project Settings / Serverless environment
# ------------------------------------------------------------
SUPABASE_URL=https://dsrvkqutqxuvmfhbcuvy.supabase.co
SUPABASE_SECRET_KEY=

# Cloudflare R2 Object Storage (Server-only credentials)
# Endpoint: https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# Keep bucket PRIVATE. Never prefix with VITE_ or expose to the browser.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ------------------------------------------------------------
# GITHUB OAUTH / APP INTEGRATION (Phase 1)
# Create OAuth App at: https://github.com/settings/developers
# Authorization callback URL: https://optic.doy.best/api/hosting/github/callback
# (For preview / local dev: https://<your-preview-url>/api/hosting/github/callback)
# Keep strictly SERVER-ONLY. Never prefix with NEXT_PUBLIC_ or VITE_
# ------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Dedicated AES-256 encryption key for persistent GitHub OAuth tokens in github_connection_secrets
GITHUB_TOKEN_ENCRYPTION_KEY=
# Optional override for canonical redirect URI:
# GITHUB_REDIRECT_URI=https://optic.doy.best/api/hosting/github/callback


